---
import Base from '../layouts/Base.astro';
import { brand, docs } from '../data/site';
---

<Base title={`Documentation – ${brand.name}`}>
  <section class="docs">
    <div class="container docs__header" data-appear>
      <p class="docs__eyebrow">{docs.eyebrow}</p>
      <h1 class="h2">{docs.title}</h1>
      <p class="lead docs__subtitle">{docs.subtitle}</p>
    </div>

    <div class="container docs__layout">
      <aside class="docs__sidebar">
        <nav class="card card--panel docs__toc" aria-label="On this page">
          <p class="docs__toc-title">{docs.tocTitle}</p>
          <ul>
            {docs.sections.map((s) => (
              <li><a href={`#${s.id}`}>{'tocLabel' in s ? s.tocLabel : s.title}</a></li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="docs__content">
        {docs.sections.map((s) => (
          <section class="docs__section" id={s.id} data-appear>
            <h2 class="docs__section-title">{s.title}</h2>
            <div class:list={['docs__blocks', `docs__blocks--${s.kind}`]}>
              {s.placeholders.map((label) => (
                <div class="card card--panel docs__block">{label}</div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .docs {
    padding-block: calc(var(--nav-h) + 72px) var(--section-pad);
  }
  .docs__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .docs__eyebrow {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .docs__subtitle {
    max-width: 520px;
  }
  .docs__layout {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: 48px;
    margin-top: 112px;
  }
  .docs__sidebar {
    position: relative;
  }
  .docs__toc {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
  }
  .docs__toc-title {
    font-size: 13px;
    font-weight: 500;
  }
  .docs__toc ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .docs__toc a {
    font-size: 12px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }
  .docs__toc a:hover {
    color: #fff;
  }
  .docs__content {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .docs__section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .docs__section-title {
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .docs__blocks {
    display: grid;
    gap: 16px;
  }
  .docs__blocks--grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .docs__block {
    padding: 24px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .docs__blocks--single .docs__block {
    min-height: 340px;
  }
  .docs__blocks--grid .docs__block {
    min-height: 220px;
  }
  .docs__blocks--rows .docs__block {
    min-height: 80px;
  }

  @media (max-width: 809.98px) {
    .docs {
      padding-top: calc(var(--nav-h) + 40px);
    }
    .docs__layout {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 56px;
    }
    .docs__toc {
      position: static;
    }
    .docs__toc ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px 20px;
    }
    .docs__blocks--grid {
      grid-template-columns: 1fr;
    }
    .docs__section-title {
      font-size: 26px;
    }
  }
</style>
