---
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import sceneThink from '../assets/art/scene-think.svg?url';
import { notFound } from '../data/site';
---

<Base title={notFound.pageTitle}>
  <section class="not-found">
    <div class="container not-found__inner" data-appear>
      <!-- The scene's question mark is dark ink drawn for the app's paper, so the scene sits on paper here too. -->
      <div class="not-found__plate">
        <img class="not-found__scene" src={sceneThink} alt="" width="200" height="130" />
      </div>
      <Tag>{notFound.tag}</Tag>
      <h1 class="h1 not-found__title" set:html={notFound.title} />
      <p class="lead not-found__subtitle">{notFound.subtitle}</p>
      <Button href={notFound.button.href}>{notFound.button.label}</Button>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding-block: calc(var(--nav-h) + 40px) var(--section-pad);
  }
  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }
  /* The app's paper (#f7f0e4, as behind the screens in the hero and in Features). The grass
     runs to the card's bottom edge, the way the app clips a scene in a card. */
  .not-found__plate {
    width: 240px;
    padding-top: 14px;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: #f7f0e4;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 24px 48px rgba(0, 0, 0, 0.35);
  }
  .not-found__scene {
    display: block;
    width: 100%;
    height: auto;
  }
  .not-found__title {
    max-width: 640px;
  }
  .not-found__subtitle {
    max-width: 480px;
  }
</style>
