---
import Tag from './Tag.astro';
import Button from './Button.astro';
import PhoneMockup from './PhoneMockup.astro';
import { hero } from '../data/site';

/**
 * Split the headline and subtitle into words so each word can fade in with
 * its own delay (the Framer template animates text per word on load).
 */
type Word = { text: string; serif?: boolean } | { br: true };
const words: Word[] = [];
for (const seg of hero.title) {
  if ('br' in seg) {
    words.push(seg);
    continue;
  }
  for (const w of seg.text.split(' ')) words.push({ text: w, serif: seg.serif });
}
const subtitleWords = hero.subtitle.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <Tag class="hero__tag">{hero.tag}</Tag>

    <h1 id="hero-title" class="h1 hero__title">
      {words.map((w, i) =>
        'br' in w ? (
          <br />
        ) : (
          <span class:list={['word', { serif: w.serif }]} style={`--i:${i}`}>{w.text}</span>
        ),
      )}
    </h1>

    <p class="lead hero__subtitle">
      {subtitleWords.map((w, i) => (
        <span class="word" style={`--i:${i}`}>{w}</span>
      ))}
    </p>

    <div class="hero__cta">
      <Button href={hero.cta.href} apple>{hero.cta.label}</Button>
      <p class="tiny dim">{hero.note}</p>
    </div>

    <PhoneMockup />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: calc(var(--nav-h) + 76px) var(--section-pad);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__title {
    max-width: 640px;
    margin-top: 24px;
    text-wrap: balance;
  }
  .hero__subtitle {
    max-width: 560px;
    margin-top: 24px;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }

  /* Word-by-word entrance */
  .word {
    display: inline-block;
    white-space: pre;
  }
  .word:not(:last-child)::after {
    content: ' ';
  }
  .js .hero__title .word,
  .js .hero__subtitle .word {
    opacity: 0;
    transform: translateY(10px);
    animation: word-in 0.45s var(--ease-out) forwards;
    animation-delay: calc(var(--start, 0.5s) + var(--i) * 0.05s);
  }
  .js .hero__subtitle .word {
    --start: 0.9s;
  }
  .js .hero__tag,
  .js .hero__cta {
    opacity: 0;
    animation: fade-in 0.6s var(--ease-out) forwards;
  }
  .js .hero__tag {
    animation-delay: 0.25s;
  }
  .js .hero__cta {
    animation-delay: 1.3s;
  }
  @keyframes word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .hero__title .word,
    .js .hero__subtitle .word,
    .js .hero__tag,
    .js .hero__cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 809.98px) {
    .hero {
      padding-top: calc(var(--nav-h) + 48px);
    }
    .hero__title {
      margin-top: 20px;
    }
  }
</style>
