---
import Tag from './Tag.astro';
import Button from './Button.astro';
import PhoneMockup from './PhoneMockup.astro';
import Glow from './Glow.astro';
import { hero } from '../data/site';

/** Split the headline into words so each can fade in with its own delay. */
type Word = { text: string; serif?: boolean } | { br: true };
const words: Word[] = [];
for (const seg of hero.title) {
  if ('br' in seg) {
    words.push(seg);
    continue;
  }
  for (const w of seg.text.split(' ')) words.push({ text: w, serif: seg.serif });
}
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__ground" aria-hidden="true">
    <svg viewBox="0 0 1440 260" preserveAspectRatio="none">
      <path class="hero__hill hero__hill--back" d="M0 120 Q360 40 720 90 T1440 70 V260 H0 Z"></path>
      <path class="hero__hill hero__hill--front" d="M0 190 Q480 120 900 175 T1440 165 V260 H0 Z"></path>
    </svg>
  </div>

  <div class="container hero__inner">
    <Tag class="hero__tag">{hero.tag}</Tag>

    <h1 id="hero-title" class="h1 hero__title">
      {words.map((w, i) =>
        'br' in w ? (
          <br />
        ) : (
          <span class:list={['word', { 'serif-italic': w.serif }]} style={`--i:${i}`}>{w.text}</span>
        ),
      )}
    </h1>

    <p class="lead hero__subtitle">{hero.subtitle}</p>

    <div class="hero__cta">
      <Button href={hero.cta.href} size="lg" apple={hero.cta.apple}>{hero.cta.label}</Button>
      <p class="tiny muted">{hero.note}</p>
    </div>

    <div class="hero__phone">
      <Glow color="var(--apricot)" x="50%" y="55%" width="60%" height="70%" opacity={0.28} />
      <PhoneMockup />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* The bottom padding keeps the landscape running under the phone's rounded corners */
    padding-block: calc(var(--nav-h) + 72px) 56px;
    overflow: hidden;
  }
  .hero__ground {
    position: absolute;
    inset: auto 0 0 0;
    height: 300px;
    pointer-events: none;
  }
  .hero__ground svg {
    width: 100%;
    height: 100%;
  }
  .hero__hill--back {
    fill: var(--grass-2);
  }
  .hero__hill--front {
    fill: var(--grass);
  }
  .hero__phone {
    position: relative;
    width: 100%;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__title {
    max-width: 720px;
    margin-top: 24px;
  }
  .hero__subtitle {
    max-width: 580px;
    margin-top: 22px;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }

  /* Word-by-word entrance */
  .word {
    display: inline-block;
    white-space: pre;
  }
  .word:not(:last-child)::after {
    content: ' ';
  }
  .js .hero__title .word {
    opacity: 0;
    transform: translateY(10px);
    animation: word-in 0.5s var(--ease-out) forwards;
    animation-delay: calc(0.35s + var(--i) * 0.06s);
  }
  .js .hero__tag,
  .js .hero__subtitle,
  .js .hero__cta {
    opacity: 0;
    animation: fade-in 0.7s var(--ease-out) forwards;
  }
  .js .hero__tag {
    animation-delay: 0.15s;
  }
  .js .hero__subtitle {
    animation-delay: 0.9s;
  }
  .js .hero__cta {
    animation-delay: 1.1s;
  }
  @keyframes word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .hero__title .word,
    .js .hero__tag,
    .js .hero__subtitle,
    .js .hero__cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 809.98px) {
    .hero {
      padding-top: calc(var(--nav-h) + 40px);
    }
    .hero__ground {
      height: 200px;
    }
  }
</style>
