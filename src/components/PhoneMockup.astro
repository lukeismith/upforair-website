---
/**
 * The hero phone: a CSS-drawn titanium frame with a pointer-driven tilt, showing a real
 * simulator capture of the app's Home screen (1320 × 2868, the 6.9-inch iPhone size).
 * The screen keeps the capture's exact aspect ratio, so nothing is cropped or stretched,
 * and the Dynamic Island sits where it sits on the phone, between the clock and the
 * status icons that the capture already shows.
 */
import { Image } from 'astro:assets';
import homeScreen from '../assets/screens/home-day-light.png';
import { hero } from '../data/site';
---

<div class="phone" data-phone>
  <div class="phone__body" data-phone-body>
    <div class="phone__frame"></div>
    <div class="phone__btn phone__btn--left"></div>
    <div class="phone__btn phone__btn--right-1"></div>
    <div class="phone__btn phone__btn--right-2"></div>

    <div class="phone__screen">
      <Image
        class="phone__shot"
        src={homeScreen}
        alt={hero.screenAlt}
        widths={[330, 660, 990, 1320]}
        sizes="(max-width: 809.98px) min(calc(76vw - 54px), 282px), 322px"
        quality={85}
        priority
      />
      <div class="phone__island" aria-hidden="true"><span class="phone__cam"></span></div>
    </div>

    <div class="phone__highlight"></div>
  </div>
</div>

<style>
  .phone {
    --frame: linear-gradient(145deg, #2d2f35 0%, #545860 28%, #24262c 64%, #14151a 100%);
    --frame-border: rgba(255, 255, 255, 0.18);
    --side-glow: rgba(255, 255, 255, 0.2);
    --bezel: 9px;

    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: 48px;
    display: flex;
    justify-content: center;
    perspective: 1400px;
  }
  .phone__body {
    position: relative;
    width: min(60%, 340px);
    padding: var(--bezel);
    transform-style: preserve-3d;
    filter: drop-shadow(0 60px 80px rgba(0, 0, 0, 0.5)) drop-shadow(0 25px 35px rgba(0, 0, 0, 0.35));
    will-change: transform;
  }
  .phone__frame {
    position: absolute;
    inset: 0;
    border-radius: 52px;
    background: var(--frame);
    border: 1px solid var(--frame-border);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55),
      inset 2px 0 8px rgba(255, 255, 255, 0.15),
      inset -4px 0 10px rgba(0, 0, 0, 0.35);
  }
  .phone__btn {
    position: absolute;
    width: 4px;
    border-radius: 4px;
    opacity: 0.75;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), rgba(20, 20, 20, 0.35));
  }
  .phone__btn--left {
    left: -3px;
    top: 30%;
    height: 70px;
  }
  .phone__btn--right-1,
  .phone__btn--right-2 {
    right: -3px;
    height: 92px;
  }
  .phone__btn--right-1 {
    top: 27%;
  }
  .phone__btn--right-2 {
    top: 43%;
  }
  .phone__screen {
    position: relative;
    /* The capture's own proportions: 440 × 956 points at 3x */
    aspect-ratio: 1320 / 2868;
    border-radius: 43px;
    overflow: hidden;
    /* The app's paper, behind the picture while it loads */
    background: #f7f0e4;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
  }
  .phone__shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The Dynamic Island: 126 × 37 points, 11 points from the top of a 440-point screen */
  .phone__island {
    position: absolute;
    top: 1.15%;
    left: 50%;
    width: 28.6%;
    aspect-ratio: 126 / 37;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0b0b0d;
  }
  .phone__cam {
    position: absolute;
    right: 9%;
    top: 50%;
    width: 18%;
    aspect-ratio: 1;
    transform: translateY(-50%);
    border-radius: 999px;
    background: rgba(12, 20, 36, 0.9);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.45);
  }

  .phone__highlight {
    position: absolute;
    inset: 2px;
    border-radius: 50px;
    border-left: 1px solid var(--side-glow);
    border-top: 1px solid var(--side-glow);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (max-width: 809.98px) {
    .phone__body {
      width: min(76%, 300px);
    }
  }
</style>

<script>
  const TILT = 10;

  for (const root of document.querySelectorAll<HTMLElement>('[data-phone]')) {
    const body = root.querySelector<HTMLElement>('[data-phone-body]');
    if (!body) continue;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarse = window.matchMedia('(pointer: coarse)');
    if (reduceMotion.matches || coarse.matches) continue;

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let idle = true;
    let inView = false;
    let idleTimer: number | undefined;

    const rest = () => {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        idle = true;
        targetX = 0;
        targetY = 0;
      }, 2000);
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) {
          idle = true;
          targetX = 0;
          targetY = 0;
        }
      },
      { threshold: 0.35 },
    ).observe(root);

    window.addEventListener(
      'pointermove',
      (e) => {
        if (!inView) return;
        const nx = Math.max(-1, Math.min(1, (e.clientX - innerWidth / 2) / (innerWidth / 2)));
        const ny = Math.max(-1, Math.min(1, (e.clientY - innerHeight / 2) / (innerHeight / 2)));
        targetX = nx * TILT;
        targetY = ny * TILT;
        idle = false;
        rest();
      },
      { passive: true },
    );
    window.addEventListener('blur', rest);
    window.addEventListener('pointercancel', rest);
    document.addEventListener('mouseleave', rest);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') rest();
    });

    const tick = () => {
      const k = idle ? 0.045 : 0.12;
      currentX += (targetX - currentX) * k;
      currentY += (targetY - currentY) * k;
      body.style.transform = `rotateX(${-currentY}deg) rotateY(${currentX}deg)`;
      window.requestAnimationFrame(tick);
    };
    tick();
  }
</script>
