---
/**
 * The hero phone: a CSS-drawn titanium frame with a pointer-driven tilt, showing
 * the app's Home screen as the Almanac design draws it: the plate, the balance,
 * the day's ledger and the tab bar.
 */
import plateDay from '../assets/art/plate-home-fine.svg?url';
import { hero } from '../data/site';

const { screen } = hero;
---

<div class="phone" data-phone role="img" aria-label="The Up For Air Home screen inside an iPhone">
  <div class="phone__body" data-phone-body>
    <div class="phone__frame"></div>
    <div class="phone__btn phone__btn--left"></div>
    <div class="phone__btn phone__btn--right-1"></div>
    <div class="phone__btn phone__btn--right-2"></div>

    <div class="phone__screen">
      <div class="phone__island"><span class="phone__cam"></span><span class="phone__sensor"></span></div>
      <div class="phone__status">
        <span class="phone__time">{screen.time}</span>
        <span class="phone__signal" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>

      <div class="phone__plate">
        <img src={plateDay} alt="" width="390" height="270" />
        <div class="phone__plate-text">
          <span class="phone__date">{screen.date}</span>
          <span class="phone__greeting">{screen.greeting}</span>
        </div>
      </div>

      <div class="phone__content">
        <div class="phone__balance">
          <div>
            <span class="phone__amount display">{screen.balance}</span>
            <span class="phone__unit">min</span>
            <span class="phone__label">{screen.balanceLabel}</span>
          </div>
          <span class="phone__dipin">{screen.dipIn}</span>
        </div>

        <div class="phone__ledger-head">
          <span class="phone__ledger-title">{screen.ledgerTitle}</span>
          <span class="phone__ledger-total">{screen.ledgerTotal}</span>
        </div>
        <ul class="phone__ledger">
          {screen.ledger.map((row) => (
            <li class:list={['phone__row', { 'phone__row--spent': row.minutes < 0 }]}>
              <svg class="pic phone__row-icon"><use href={`#p-${row.icon}`}></use></svg>
              <span class="phone__row-text">
                <span class="phone__row-title">{row.title}</span>
                <span class="phone__row-detail">{row.detail}</span>
              </span>
              <span class="phone__row-min">
                <span class="phone__row-num">{row.minutes < 0 ? `−${Math.abs(row.minutes)}` : row.minutes}</span>
                <span class="phone__row-unit">min</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="phone__tabs">
        {screen.tabs.map((tab, i) => (
          <span class:list={['phone__tab', { 'is-active': i === 0 }]}>
            <svg class="pic"><use href={`#p-${tab.icon}`}></use></svg>
            <span>{tab.label}</span>
          </span>
        ))}
      </div>
    </div>

    <div class="phone__highlight"></div>
  </div>
</div>

<style>
  .phone {
    --frame: linear-gradient(145deg, #2d2f35 0%, #545860 28%, #24262c 64%, #14151a 100%);
    --frame-border: rgba(255, 255, 255, 0.18);
    --side-glow: rgba(255, 255, 255, 0.2);

    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: 48px;
    display: flex;
    justify-content: center;
    perspective: 1400px;
  }
  .phone__body {
    position: relative;
    width: min(60%, 340px);
    aspect-ratio: 1 / 2.03;
    transform-style: preserve-3d;
    filter: drop-shadow(0 60px 80px rgba(0, 0, 0, 0.5)) drop-shadow(0 25px 35px rgba(0, 0, 0, 0.35));
    will-change: transform;
  }
  .phone__frame {
    position: absolute;
    inset: 0;
    border-radius: 52px;
    background: var(--frame);
    border: 1px solid var(--frame-border);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55),
      inset 2px 0 8px rgba(255, 255, 255, 0.15),
      inset -4px 0 10px rgba(0, 0, 0, 0.35);
  }
  .phone__btn {
    position: absolute;
    width: 4px;
    border-radius: 4px;
    opacity: 0.75;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), rgba(20, 20, 20, 0.35));
  }
  .phone__btn--left {
    left: -3px;
    top: 30%;
    height: 70px;
  }
  .phone__btn--right-1,
  .phone__btn--right-2 {
    right: -3px;
    height: 92px;
  }
  .phone__btn--right-1 {
    top: 27%;
  }
  .phone__btn--right-2 {
    top: 43%;
  }
  .phone__screen {
    /* The app's own light palette, fixed, so the screen reads as the product */
    --p-paper: #f7f0e4;
    --p-page: #fffbf4;
    --p-ink: #1f1a17;
    --p-ink-2: #5c544d;
    --p-ink-3: #8a8078;
    --p-rule: #e2d8c6;
    --p-apricot: #f0a35e;
    --p-terracotta: #b8432b;

    position: absolute;
    inset: 9px;
    display: flex;
    flex-direction: column;
    border-radius: 44px;
    overflow: hidden;
    background: var(--p-paper);
    color: var(--p-ink);
    border: 1px solid rgba(0, 0, 0, 0.35);
    font-size: 11px;
    line-height: 1.3;
  }
  .phone__island {
    position: absolute;
    top: 8px;
    left: 50%;
    z-index: 6;
    width: 37%;
    height: 30px;
    transform: translateX(-50%);
    border-radius: 18px;
    background: #0b0b0d;
  }
  .phone__cam {
    position: absolute;
    left: 13px;
    top: 10px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgba(12, 20, 36, 0.9);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.45);
  }
  .phone__sensor {
    position: absolute;
    right: 13px;
    top: 11px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(28, 28, 28, 0.95);
  }
  .phone__status {
    position: absolute;
    top: 14px;
    left: 26px;
    right: 26px;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
  }
  .phone__signal {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 9px;
  }
  .phone__signal i {
    width: 3px;
    background: currentColor;
    border-radius: 1px;
  }
  .phone__signal i:nth-child(1) {
    height: 4px;
  }
  .phone__signal i:nth-child(2) {
    height: 6px;
  }
  .phone__signal i:nth-child(3) {
    height: 9px;
  }

  /* The plate */
  .phone__plate {
    position: relative;
    height: 42%;
    flex: none;
    overflow: hidden;
  }
  .phone__plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .phone__plate-text {
    position: absolute;
    left: 18px;
    right: 110px;
    top: 44px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .phone__date {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1f1a17;
  }
  .phone__greeting {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-variation-settings: 'SOFT' 70, 'WONK' 1;
    font-size: 15px;
    line-height: 1.15;
    color: #1f1a17;
  }

  /* Balance and ledger */
  .phone__content {
    flex: 1;
    padding: 12px 16px 0;
    overflow: hidden;
  }
  .phone__balance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
  }
  .phone__amount {
    font-size: 40px;
    line-height: 1;
  }
  .phone__unit {
    margin-left: 4px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 14px;
  }
  .phone__label {
    display: block;
    margin-top: 2px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-ink-2);
  }
  .phone__dipin {
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--p-ink);
    color: var(--p-paper);
    font-size: 11px;
    font-weight: 600;
  }
  .phone__ledger-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0 6px;
    border-bottom: 1px solid var(--p-ink);
  }
  .phone__ledger-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 13px;
  }
  .phone__ledger-total {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-ink-2);
  }
  .phone__ledger {
    display: flex;
    flex-direction: column;
  }
  .phone__row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid var(--p-rule);
  }
  .phone__row-icon {
    width: 14px;
    height: 14px;
    color: var(--p-ink-2);
  }
  .phone__row-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .phone__row-title {
    font-size: 11px;
    font-weight: 600;
  }
  .phone__row-detail {
    font-size: 8.5px;
    color: var(--p-ink-2);
  }
  .phone__row-min {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }
  .phone__row-num {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .phone__row-unit {
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-ink-2);
  }
  .phone__row--spent .phone__row-num,
  .phone__row--spent .phone__row-unit {
    color: var(--p-terracotta);
  }

  /* Tab bar */
  .phone__tabs {
    flex: none;
    display: flex;
    justify-content: space-around;
    padding: 8px 8px 16px;
    border-top: 1px solid var(--p-rule);
    background: var(--p-paper);
  }
  .phone__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 7.5px;
    font-weight: 600;
    color: var(--p-ink-3);
  }
  .phone__tab .pic {
    width: 15px;
    height: 15px;
  }
  .phone__tab.is-active {
    color: var(--p-ink);
  }
  .phone__tab.is-active .pic {
    color: var(--p-apricot);
  }

  .phone__highlight {
    position: absolute;
    inset: 2px;
    border-radius: 50px;
    border-left: 1px solid var(--side-glow);
    border-top: 1px solid var(--side-glow);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (max-width: 809.98px) {
    .phone__body {
      width: min(76%, 300px);
    }
  }
</style>

<script>
  const TILT = 10;

  for (const root of document.querySelectorAll<HTMLElement>('[data-phone]')) {
    const body = root.querySelector<HTMLElement>('[data-phone-body]');
    if (!body) continue;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarse = window.matchMedia('(pointer: coarse)');
    if (reduceMotion.matches || coarse.matches) continue;

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let idle = true;
    let inView = false;
    let idleTimer: number | undefined;

    const rest = () => {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        idle = true;
        targetX = 0;
        targetY = 0;
      }, 2000);
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) {
          idle = true;
          targetX = 0;
          targetY = 0;
        }
      },
      { threshold: 0.35 },
    ).observe(root);

    window.addEventListener(
      'pointermove',
      (e) => {
        if (!inView) return;
        const nx = Math.max(-1, Math.min(1, (e.clientX - innerWidth / 2) / (innerWidth / 2)));
        const ny = Math.max(-1, Math.min(1, (e.clientY - innerHeight / 2) / (innerHeight / 2)));
        targetX = nx * TILT;
        targetY = ny * TILT;
        idle = false;
        rest();
      },
      { passive: true },
    );
    window.addEventListener('blur', rest);
    window.addEventListener('pointercancel', rest);
    document.addEventListener('mouseleave', rest);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') rest();
    });

    const tick = () => {
      const k = idle ? 0.045 : 0.12;
      currentX += (targetX - currentX) * k;
      currentY += (targetY - currentY) * k;
      body.style.transform = `rotateX(${-currentY}deg) rotateY(${currentX}deg)`;
      window.requestAnimationFrame(tick);
    };
    tick();
  }
</script>
