---
import SectionHeader from './SectionHeader.astro';
import Glow from './Glow.astro';
import sceneInHole from '../assets/art/scene-in-hole.svg?url';
import sceneWalk from '../assets/art/scene-walk.svg?url';
import sceneClimbOut from '../assets/art/scene-climb-out.svg?url';
import { howItWorks } from '../data/site';

const art: Record<string, string> = {
  'scene-in-hole': sceneInHole,
  'scene-walk': sceneWalk,
  'scene-climb-out': sceneClimbOut,
};
---

<section class="section how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <SectionHeader tag={howItWorks.tag} title={howItWorks.title} subtitle={howItWorks.subtitle} />

    <ol class="how__grid">
      <Glow color="var(--terracotta)" x="50%" y="40%" width="80%" height="70%" opacity={0.14} />
      {howItWorks.steps.map((step, i) => (
        <li class="card how__card" data-appear style={`--appear-delay:${i * 0.1}s`}>
          <span class="how__number" aria-hidden="true">{i + 1}</span>
          <div class="how__art">
            <img src={art[step.art]} alt="" width="200" height="130" loading="lazy" />
          </div>
          <h3 class="h3">{step.title}</h3>
          <p class="body">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 56px;
  }
  .how__card {
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 24px 28px;
  }
  .how__number {
    position: absolute;
    top: 0;
    left: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 26px;
    padding-inline: 10px;
    transform: translateY(-50%);
    border-radius: var(--radius-pill);
    background: var(--well);
    box-shadow: 0 0 0 1px var(--border);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 14px;
  }
  .how__art {
    display: flex;
    justify-content: center;
    padding: 12px 0 8px;
  }
  .how__art img {
    width: 100%;
    max-width: 240px;
    height: auto;
  }
  .how__card .h3 {
    margin-top: 6px;
  }

  @media (max-width: 1199.98px) {
    .how__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 809.98px) {
    .how__grid {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 44px;
    }
  }
</style>
