---
/**
 * A soft radial glow behind a group of cards: the template's gradient glows,
 * in the Almanac's warm colours. Pure CSS, no image.
 */
interface Props {
  color?: string;
  x?: string;
  y?: string;
  width?: string;
  height?: string;
  opacity?: number;
  class?: string;
}
const {
  color = 'var(--apricot)',
  x = '50%',
  y = '50%',
  width = '70%',
  height = '60%',
  opacity = 0.2,
  class: cls,
} = Astro.props;
---

<div
  class:list={['glow', cls]}
  aria-hidden="true"
  style={`--gc:${color};--gx:${x};--gy:${y};--gw:${width};--gh:${height};--go:${opacity}`}
>
</div>

<style>
  .glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: var(--go);
    background: radial-gradient(var(--gw) var(--gh) at var(--gx) var(--gy), var(--gc), transparent 70%);
    filter: blur(24px);
  }
</style>
