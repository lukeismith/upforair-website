---
/**
 * Soft gradient glow that sits behind a group of cards. Mirrors the Framer
 * setup: a large blurred image, radial mask so it fades out at the edges,
 * an optional hue rotation, and reduced opacity.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Degrees of hue rotation applied to the image. */
  hue?: number;
  opacity?: number;
  /** CSS object-position for the image. */
  position?: string;
  class?: string;
}
const { src, hue = 0, opacity = 0.75, position = 'center', class: cls } = Astro.props;
---

<div
  class:list={['glow', cls]}
  aria-hidden="true"
  style={`--hue:${hue}deg;--opacity:${opacity};--pos:${position}`}
>
  <Image src={src} alt="" widths={[640, 1280, 1920]} sizes="(max-width: 809px) 100vw, 1200px" loading="lazy" />
</div>

<style>
  .glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--opacity);
    filter: hue-rotate(var(--hue));
    -webkit-mask-image: radial-gradient(50% 50% at 50% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(50% 50% at 50% 50%, #000 0%, transparent 100%);
  }
  .glow :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
</style>
