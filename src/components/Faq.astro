---
import SectionHeader from './SectionHeader.astro';
import { faq } from '../data/site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container">
    <SectionHeader tag={faq.tag} title={faq.title} subtitle={faq.subtitle} />

    <div class="faq__list" data-faq data-appear>
      {faq.items.map((item, i) => (
        <div class:list={['faq__item', { 'is-open': i === 0 }]} data-faq-item>
          <h3 class="faq__heading">
            <button
              class="faq__question"
              type="button"
              id={`faq-q-${i}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`faq-a-${i}`}
            >
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true"><i></i><i></i></span>
            </button>
          </h3>
          <div class="faq__answer" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
            <div>
              <p class="faq__answer-text">{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(100%, 800px);
    margin: 44px auto 0;
  }
  .faq__item {
    padding: 4px 20px;
    border-radius: var(--radius-panel);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: background-color 0.25s ease;
  }
  .faq__item:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .faq__heading {
    margin: 0;
    font: inherit;
  }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 16px 0;
    text-align: left;
    font-family: var(--font-serif);
    font-weight: 600;
    font-variation-settings: 'SOFT' 60, 'WONK' 0;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }
  .faq__question:hover {
    color: var(--link);
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .faq__icon i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
  }
  .faq__icon i:last-child {
    transform: rotate(90deg);
  }
  .is-open .faq__icon i:last-child {
    transform: rotate(0deg);
  }
  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.35s var(--ease-out),
      opacity 0.3s ease;
  }
  .faq__answer > div {
    overflow: hidden;
  }
  .is-open .faq__answer {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .faq__answer-text {
    padding: 0 0 18px;
    max-width: 640px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  @media (max-width: 809.98px) {
    .faq__question {
      font-size: 18px;
      padding-block: 16px;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-faq-item]'));

    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('button')?.setAttribute('aria-expanded', String(open));
    };

    for (const item of items) {
      item.querySelector('button')?.addEventListener('click', () => {
        const willOpen = !item.classList.contains('is-open');
        items.forEach((other) => setOpen(other, other === item && willOpen));
      });
    }
  }
</script>
