---
import SectionHeader from './SectionHeader.astro';
import Tag from './Tag.astro';
import Button from './Button.astro';
import Check from './icons/Check.astro';
import Glow from './Glow.astro';
import { pricing } from '../data/site';

const { free, premium } = pricing;
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title" data-pricing data-billing="yearly">
  <div class="container">
    <SectionHeader tag={pricing.tag} title={pricing.title} subtitle={pricing.subtitle} />

    <div class="pricing__toggle" data-appear="fade">
      <button class="pricing__label" type="button" data-billing-set="monthly">{pricing.toggle.monthly}</button>
      <label class="switch">
        <span class="sr-only">Bill yearly</span>
        <input type="checkbox" role="switch" checked data-billing-toggle />
        <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
      </label>
      <button class="pricing__label" type="button" data-billing-set="yearly">{pricing.toggle.yearly}</button>
      <Tag tone="apricot">{pricing.toggle.badge}</Tag>
    </div>

    <div class="pricing__grid">
      <Glow color="var(--terracotta)" x="50%" y="50%" width="80%" height="80%" opacity={0.16} />
      <article class="card plan" data-appear>
        <div class="plan__top">
          <h3 class="plan__name">{free.name}</h3>
          <p class="plan__price">
            <span class="display plan__amount">{free.price}</span>
          </p>
          <p class="body">{free.description}</p>
        </div>
        <div class="plan__cta">
          <Button href={free.cta.href} variant="outlined" block>{free.cta.label}</Button>
          <p class="tiny muted plan__note">Free stays free.</p>
        </div>
        <div class="plan__features">
          <p class="small plan__features-label">{free.featuresLabel}</p>
          <ul class="plan__list">
            {free.features.map((f) => (
              <li><Check class="plan__check" /><span>{f}</span></li>
            ))}
          </ul>
        </div>
      </article>

      <article class="card plan plan--premium" data-appear style="--appear-delay:0.1s">
        <div class="plan__top">
          <h3 class="plan__name">
            {premium.name}
            <span class="plan__best" data-only="yearly"><Tag>Best value</Tag></span>
          </h3>
          <p class="plan__price">
            <span class="display plan__amount" data-price data-monthly={premium.monthly.price} data-yearly={premium.yearly.price}>{premium.yearly.price}</span>
            <span class="plan__period" data-period data-monthly={premium.monthly.period} data-yearly={premium.yearly.period}>{premium.yearly.period}</span>
          </p>
          <p class="tiny muted plan__permonth" data-only="yearly">{premium.yearly.perMonth}</p>
          <p class="body">{premium.description}</p>
        </div>
        <div class="plan__cta">
          <Button href={premium.cta.href} block data-cta data-monthly={premium.cta.monthly} data-yearly={premium.cta.yearly}>{premium.cta.yearly}</Button>
          <p class="tiny muted plan__note" data-note data-monthly={premium.monthly.note} data-yearly={premium.yearly.note}>{premium.yearly.note}</p>
        </div>
        <div class="plan__features">
          <p class="small plan__features-label">{premium.featuresLabel}</p>
          <ul class="plan__list">
            {premium.features.map((f) => (
              <li><Check class="plan__check" /><span>{f}</span></li>
            ))}
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .pricing__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 44px;
  }
  .pricing__label {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }
  .pricing__label:hover {
    color: var(--text);
  }
  [data-billing='yearly'] .pricing__label[data-billing-set='yearly'],
  [data-billing='monthly'] .pricing__label[data-billing-set='monthly'] {
    color: var(--text);
  }

  /* Switch */
  .switch {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }
  .switch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .switch__track {
    position: relative;
    width: 46px;
    height: 26px;
    border-radius: 999px;
    background: var(--rule-2);
    transition: background-color 0.25s ease;
  }
  .switch__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    transition: transform 0.3s var(--ease-out);
  }
  .switch input:checked + .switch__track {
    background: var(--apricot);
  }
  .switch input:checked + .switch__track .switch__thumb {
    transform: translateX(20px);
  }
  .switch input:focus-visible + .switch__track {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
  }

  /* Cards */
  .pricing__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    width: min(100%, 900px);
    margin: 32px auto 0;
  }
  .plan {
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 36px 32px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .plan--premium {
    background: rgba(240, 163, 94, 0.08);
    box-shadow: inset 0 0 0 1px rgba(240, 163, 94, 0.3);
  }
  .plan__top {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .plan__name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-variation-settings: 'SOFT' 60, 'WONK' 0;
    font-size: 22px;
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .plan__amount {
    font-size: 56px;
  }
  .plan__period {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 20px;
  }
  .plan__permonth {
    margin-top: -6px;
  }
  .plan__cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }
  .plan__features {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .plan__features-label {
    font-weight: 600;
  }
  .plan__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plan__list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.4;
  }
  .pricing :global(.plan__check) {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 3px;
    color: var(--apricot);
  }
  [data-billing='monthly'] [data-only='yearly'] {
    display: none;
  }

  @media (max-width: 809.98px) {
    .pricing__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .plan {
      padding: 28px 22px;
    }
    .pricing__toggle {
      flex-wrap: wrap;
      gap: 10px;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pricing]')) {
    const toggle = root.querySelector<HTMLInputElement>('[data-billing-toggle]');
    if (!toggle) continue;

    const swap = (selector: string) => {
      const yearly = toggle.checked;
      root.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        const value = yearly ? el.dataset.yearly : el.dataset.monthly;
        if (value === undefined) return;
        const label = el.querySelector<HTMLElement>('.btn__label');
        (label ?? el).textContent = value;
      });
    };

    const apply = () => {
      root.dataset.billing = toggle.checked ? 'yearly' : 'monthly';
      swap('[data-price]');
      swap('[data-period]');
      swap('[data-cta]');
      swap('[data-note]');
    };

    toggle.addEventListener('change', apply);
    root.querySelectorAll<HTMLButtonElement>('[data-billing-set]').forEach((btn) => {
      btn.addEventListener('click', () => {
        toggle.checked = btn.dataset.billingSet === 'yearly';
        apply();
      });
    });
    apply();
  }
</script>
