---
interface Props {
  class?: string;
  /** apricot: the warm ribbon tint, with terracotta text. */
  tone?: 'well' | 'apricot';
  [key: string]: unknown;
}
const { class: cls, tone = 'well', ...rest } = Astro.props;
---

<span class:list={['tag', `tag--${tone}`, cls]} {...rest}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgba(13, 13, 13, 0.4);
    box-shadow: inset 0 0 0 1px var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text);
    white-space: nowrap;
  }
  .tag--apricot {
    background: var(--accent-soft);
    box-shadow: none;
    color: var(--apricot);
  }
</style>
