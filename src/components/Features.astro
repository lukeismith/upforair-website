---
/**
 * Three features on the left drive an illustration on the right: the rabbit holes,
 * the day's ledger, and the limit screen. Hover (or tap) a feature to switch.
 */
import SectionHeader from './SectionHeader.astro';
import Glow from './Glow.astro';
import { features } from '../data/site';

const { items, panels } = features;
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="container">
    <SectionHeader tag={features.tag} title={features.title} />

    <div class="features__inner" data-features>
      <div class="features__list" role="tablist" aria-orientation="vertical" data-appear>
        {items.map((item, i) => (
          <button
            class:list={['features__item', { 'is-active': i === 0 }]}
            type="button"
            role="tab"
            id={`feature-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="feature-illustration"
            tabindex={i === 0 ? 0 : -1}
            data-feature
          >
            <span class="h3">{item.title}</span>
            <span class="body">{item.body}</span>
          </button>
        ))}
      </div>

      <div class="features__stage" data-appear>
        <Glow color="var(--apricot)" x="50%" y="50%" width="90%" height="90%" opacity={0.2} />
        <div class="card mock" id="feature-illustration" role="tabpanel" aria-label="App illustration" data-illustration data-state="1">
          <!-- 1 · Rabbit holes -->
          <div class="mock__panel" data-panel="1">
            <div class="mock__head">
              <span class="mock__title">{panels.holes.title}</span>
              <span class="mock__link">{panels.holes.edit}</span>
            </div>
            <div class="mock__tiles">
              {panels.holes.tiles.map((tile) => (
                <div class="mock__tile">
                  <span class="mock__appicon" style={`background:${tile.color}`}>
                    <span>{tile.initials}</span>
                    <span class="mock__badge"><svg class="pic"><use href="#p-lock"></use></svg></span>
                  </span>
                  <span class="mock__tile-name">{tile.name}</span>
                  <span class="mock__tile-status">{tile.status}</span>
                </div>
              ))}
            </div>
            <ul class="mock__holes">
              {panels.holes.rows.map((row) => (
                <li class="mock__hole">
                  <span class="mock__hole-kind">{row.kind}</span>
                  <span class="mock__hole-name">
                    <svg class="pic"><use href="#p-lock"></use></svg>
                    {row.name}
                  </span>
                  <span class="mock__hole-count">{row.count}</span>
                </li>
              ))}
            </ul>
            <p class="mock__note">{panels.holes.note}</p>
          </div>

          <!-- 2 · The ledger -->
          <div class="mock__panel" data-panel="2">
            <span class="eyebrow">{panels.earn.eyebrow}</span>
            <div class="mock__total">
              <span class="display mock__total-num">{panels.earn.total}</span>
              <span class="mock__total-unit">min</span>
            </div>
            <ul class="mock__ledger">
              {panels.earn.rows.map((row) => (
                <li class="mock__row">
                  <svg class="pic"><use href={`#p-${row.icon}`}></use></svg>
                  <span class="mock__row-text">
                    <span class="mock__row-title">{row.title}</span>
                    <span class="mock__row-rate">{row.rate}</span>
                  </span>
                  <span class="mock__row-min"><span class="mock__row-num">{row.minutes}</span><span class="mock__row-unit">min</span></span>
                </li>
              ))}
            </ul>
          </div>

          <!-- 3 · The limit screen -->
          <div class="mock__panel" data-panel="3">
            <div class="mock__head">
              <span class="mock__link">{panels.limit.neverMind}</span>
              <span class="eyebrow">{panels.limit.eyebrow}</span>
            </div>
            <div class="mock__limit">
              <div class="mock__total mock__total--big">
                <span class="display mock__total-num">{panels.limit.minutes}</span>
                <span class="mock__total-unit">min</span>
              </div>
              <span class="mock__ends serif-italic">{panels.limit.ends}</span>
              <div class="mock__slider" aria-hidden="true"><span class="mock__knob"></span></div>
              <div class="mock__chips">
                {panels.limit.chips.map((c) => (
                  <span class:list={['mock__chip', { 'is-selected': c === panels.limit.minutes }]}>{c}</span>
                ))}
              </div>
              <span class="mock__commit">{panels.limit.commit}</span>
              <span class="mock__note">{panels.limit.footer}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features__inner {
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    margin-top: 56px;
  }

  /* --- Tabs --- */
  .features__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .features__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 22px 24px;
    border-radius: var(--radius-panel);
    text-align: left;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      background-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .features__item .body {
    max-width: 380px;
  }
  .features__item:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  .features__item.is-active {
    background: var(--page);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  /* --- Illustration --- */
  .features__stage {
    position: relative;
  }
  .mock {
    position: relative;
    z-index: 1;
    min-height: 480px;
    overflow: hidden;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .mock__panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
    pointer-events: none;
  }
  .mock[data-state='1'] .mock__panel[data-panel='1'],
  .mock[data-state='2'] .mock__panel[data-panel='2'],
  .mock[data-state='3'] .mock__panel[data-panel='3'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .mock__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .mock__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-variation-settings: 'SOFT' 60, 'WONK' 0;
    font-size: 22px;
  }
  .mock__link {
    color: var(--link);
    font-weight: 600;
    font-size: 15px;
  }
  .mock__note {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Tiles */
  .mock__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .mock__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 18px 10px 14px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule);
    text-align: center;
  }
  .mock__appicon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 13px;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
  }
  .mock__badge {
    position: absolute;
    right: -6px;
    bottom: -6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--solid);
    box-shadow: inset 0 0 0 1.5px var(--ink);
    color: var(--ink);
  }
  .mock__badge .pic {
    width: 13px;
    height: 13px;
  }
  .mock__tile-name {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .mock__tile-status {
    font-size: 12px;
    color: var(--text-muted);
  }
  .mock__holes {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
    border-top: 1px solid var(--ink);
  }
  .mock__hole {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 14px;
  }
  .mock__hole-kind {
    font-weight: 600;
  }
  .mock__hole-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .mock__hole-name .pic {
    width: 16px;
    height: 16px;
    color: var(--ink-2);
  }
  .mock__hole-count {
    font-size: 12.5px;
    color: var(--text-muted);
  }

  /* Ledger */
  .mock__total {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .mock__total-num {
    font-size: 64px;
  }
  .mock__total--big .mock__total-num {
    font-size: 96px;
  }
  .mock__total-unit {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 20px;
  }
  .mock__ledger {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--ink);
  }
  .mock__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .mock__row .pic {
    color: var(--ink-2);
  }
  .mock__row-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mock__row-title {
    font-weight: 600;
    font-size: 15px;
  }
  .mock__row-rate {
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .mock__row-min {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .mock__row-num {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    font-variant-numeric: tabular-nums;
  }
  .mock__row-unit {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Limit screen */
  .mock__limit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    flex: 1;
    justify-content: center;
    text-align: center;
  }
  .mock__ends {
    font-size: 24px;
  }
  .mock__slider {
    position: relative;
    width: 100%;
    height: 1px;
    margin: 12px 0;
    background: var(--rule-2);
  }
  .mock__knob {
    position: absolute;
    left: 42%;
    top: 50%;
    width: 22px;
    height: 22px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: var(--solid);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .mock__chips {
    display: flex;
    gap: 8px;
  }
  .mock__chip {
    min-width: 52px;
    padding: 7px 12px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--rule-2);
    font-weight: 600;
    font-size: 14px;
    text-align: center;
  }
  .mock__chip.is-selected {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }
  .mock__commit {
    width: 100%;
    padding: 14px 18px;
    border-radius: var(--radius-btn);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-weight: 600;
    font-size: 15px;
  }

  @media (max-width: 1199.98px) {
    .features__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (max-width: 809.98px) {
    .features__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 40px;
    }
    .features__item .body {
      max-width: none;
    }
    .mock {
      min-height: 440px;
    }
    .mock__panel {
      padding: 22px 18px;
    }
    .mock__total--big .mock__total-num {
      font-size: 80px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mock__panel {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-features]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-feature]'));
    const stage = root.querySelector<HTMLElement>('[data-illustration]');
    if (!stage || tabs.length === 0) continue;

    const activate = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      stage.dataset.state = String(index + 1);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') activate(i);
      });
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('focus', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const next = (i + (e.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].focus();
      });
    });
  }
</script>
