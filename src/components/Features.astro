---
/**
 * Three features on the left drive an illustration on the right: the rabbit holes,
 * the ways to earn minutes, and the screen that asks how long. Hover (or tap) a feature
 * to switch. Each panel is an app screen on the app's own paper. Earn and the limit
 * screen are real simulator captures, cut off below the part that matters. The
 * simulator has no Screen Time, so its Rabbit holes page is empty, and that panel is an
 * HTML replica of the page with the app's own words, drawn at the same scale as the
 * captures (one app point is 1/440 of the screen's width).
 */
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import Glow from './Glow.astro';
import earnScreen from '../assets/screens/earn-light-top.png';
import limitScreen from '../assets/screens/unlock-limit-15-light-top.png';
import { features } from '../data/site';

const { items, panels } = features;
const holes = panels.holes;
/** The screens are 360px wide at most; on a narrow phone, the viewport less the gutters and padding. */
const screenSizes = '(max-width: 443.98px) calc(100vw - 84px), 360px';
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="container">
    <SectionHeader tag={features.tag} title={features.title} />

    <div class="features__inner" data-features>
      <div class="features__list" role="tablist" aria-orientation="vertical" data-appear>
        {items.map((item, i) => (
          <button
            class:list={['features__item', { 'is-active': i === 0 }]}
            type="button"
            role="tab"
            id={`feature-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="feature-illustration"
            tabindex={i === 0 ? 0 : -1}
            data-feature
          >
            <span class="h3">{item.title}</span>
            <span class="body">{item.body}</span>
          </button>
        ))}
      </div>

      <div class="features__stage" data-appear>
        <Glow color="var(--apricot)" x="50%" y="50%" width="90%" height="90%" opacity={0.2} />
        <div class="card mock" id="feature-illustration" role="tabpanel" aria-labelledby="feature-tab-0" data-illustration data-state="1">
          <!-- 1 · Rabbit holes (replica) -->
          <div class="mock__panel" data-panel="1">
            <div class="mock__screen mock__screen--replica">
              <div class="rh">
                <div class="rh__status" aria-hidden="true">
                  <span class="rh__time">{holes.time}</span>
                  <span class="rh__icons">
                    <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg>
                    <svg viewBox="0 0 16 12"><path d="M8 2.2c2.4 0 4.6.9 6.2 2.5l1.3-1.4C13.6 1.3 10.9.2 8 .2S2.4 1.3.5 3.3l1.3 1.4C3.4 3.1 5.6 2.2 8 2.2Zm0 3.6c1.4 0 2.7.5 3.6 1.4l1.3-1.4C11.6 4.6 9.9 3.8 8 3.8s-3.6.8-4.9 2l1.3 1.4c.9-.9 2.2-1.4 3.6-1.4Zm0 3.4c-.5 0-1 .2-1.3.5L8 11.8l1.3-2.1c-.3-.3-.8-.5-1.3-.5Z"></path></svg>
                    <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.5" fill="none" stroke="currentColor" opacity="0.4"></rect><rect x="2" y="2" width="20" height="8" rx="2"></rect><path d="M25 4v4c.8-.3 1.3-1.1 1.3-2S25.8 4.3 25 4Z" opacity="0.4"></path></svg>
                  </span>
                </div>

                <div class="rh__bar">
                  <span class="rh__round" aria-hidden="true"><svg class="pic rh__back"><use href="#p-chevron"></use></svg></span>
                  <span class="rh__title">{holes.title}</span>
                  <span class="rh__edit">{holes.edit}</span>
                </div>

                {holes.groups.map((group) => (
                  <div class="rh__group">
                    <p class="rh__eyebrow">{group.title}</p>
                    <ul class="rh__card">
                      {group.rows.map((row) => (
                        <li class="rh__row">
                          {'glyph' in row ? (
                            <svg class="pic rh__glyph" aria-hidden="true"><use href={`#p-${row.glyph}`}></use></svg>
                          ) : (
                            <span class="rh__icon" style={`background:${row.color}`} aria-hidden="true">
                              {'initials' in row ? <span>{row.initials}</span> : <svg class="pic"><use href={`#p-${row.icon}`}></use></svg>}
                              <span class="rh__badge"><svg class="pic"><use href="#p-lock"></use></svg></span>
                            </span>
                          )}
                          <span class="rh__text">
                            <span class="rh__name">{row.name}</span>
                            {'detail' in row && <span class="rh__detail">{row.detail}</span>}
                          </span>
                        </li>
                      ))}
                      {'limit' in group && group.limit && (
                        <li class="rh__row rh__row--text">
                          <span class="rh__text">
                            <span class="rh__limit">{group.limit.title}</span>
                            <span class="rh__detail">
                              {group.limit.before}<span class="rh__link">{group.limit.link}</span>{group.limit.after}
                            </span>
                          </span>
                        </li>
                      )}
                      {'add' in group && group.add && (
                        <li class="rh__row rh__row--text">
                          <span class="rh__text rh__text--add">
                            <span class="rh__add">{group.add}</span>
                            {'addDetail' in group && group.addDetail && <span class="rh__detail">{group.addDetail}</span>}
                          </span>
                        </li>
                      )}
                    </ul>
                  </div>
                ))}

                <p class="rh__footer">{holes.footer}</p>
              </div>
            </div>
          </div>

          <!-- 2 · Earn (capture) -->
          <div class="mock__panel" data-panel="2">
            <Image
              class="mock__screen"
              src={earnScreen}
              alt={panels.earn.alt}
              widths={[360, 720, 1080, 1320]}
              sizes={screenSizes}
              quality={85}
            />
          </div>

          <!-- 3 · How long (capture) -->
          <div class="mock__panel" data-panel="3">
            <Image
              class="mock__screen"
              src={limitScreen}
              alt={panels.limit.alt}
              widths={[360, 720, 1080, 1320]}
              sizes={screenSizes}
              quality={85}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features__inner {
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    margin-top: 56px;
  }

  /* --- Tabs --- */
  .features__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .features__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 22px 24px;
    border-radius: var(--radius-panel);
    text-align: left;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      background-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .features__item .body {
    max-width: 380px;
  }
  .features__item:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  .features__item.is-active {
    background: var(--page);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  /* --- Illustration --- */
  .features__stage {
    position: relative;
  }
  .mock {
    position: relative;
    z-index: 1;
    /* All three panels share one grid cell, so the card is as tall as the tallest */
    display: grid;
    overflow: hidden;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .mock__panel {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out),
      visibility 0s linear 0.45s;
    visibility: hidden;
    pointer-events: none;
  }
  .mock[data-state='1'] .mock__panel[data-panel='1'],
  .mock[data-state='2'] .mock__panel[data-panel='2'],
  .mock[data-state='3'] .mock__panel[data-panel='3'] {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* An app screen on paper: the captures, and the replica drawn to match them */
  .mock__screen {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    border-radius: 22px;
    background: #f7f0e4;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 24px 48px rgba(0, 0, 0, 0.35);
  }

  /* --- The Rabbit holes replica, in app points (1pt = 1/440 of the screen) --- */
  .mock__screen--replica {
    overflow: hidden;
    container-type: inline-size;
  }
  .rh {
    --pt: calc(100cqw / 440);
    --ink: #1f1a17;
    --ink-2: #5c544d;
    --rule: #e2d8c6;
    --page: #fffbf4;
    --terracotta: #b8432b;

    display: flex;
    flex-direction: column;
    padding: 0 calc(20 * var(--pt)) calc(28 * var(--pt));
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: calc(17 * var(--pt));
    line-height: 1.3;
    text-align: left;
  }
  .rh__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(54 * var(--pt));
    padding: calc(4 * var(--pt)) calc(14 * var(--pt)) 0 calc(36 * var(--pt));
    font-size: calc(17 * var(--pt));
    font-weight: 600;
  }
  .rh__icons {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--pt));
  }
  .rh__icons svg {
    width: auto;
    height: calc(12 * var(--pt));
    fill: currentColor;
  }
  .rh__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: calc(56 * var(--pt));
  }
  .rh__round,
  .rh__edit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: calc(44 * var(--pt));
    border-radius: 999px;
    background: var(--page);
    box-shadow:
      0 0 0 calc(1 * var(--pt)) var(--rule),
      0 calc(2 * var(--pt)) calc(6 * var(--pt)) rgba(31, 26, 23, 0.06);
  }
  .rh__round {
    width: calc(44 * var(--pt));
  }
  .rh__back {
    width: calc(22 * var(--pt));
    height: calc(22 * var(--pt));
    transform: scaleX(-1);
  }
  .rh__title {
    font-weight: 600;
    font-size: calc(17 * var(--pt));
  }
  .rh__edit {
    justify-self: end;
    padding: 0 calc(16 * var(--pt));
    color: var(--terracotta);
    font-size: calc(17 * var(--pt));
  }
  .rh__group {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--pt));
    margin-top: calc(16 * var(--pt));
  }
  .rh__eyebrow {
    padding-left: calc(2 * var(--pt));
    font-size: calc(12 * var(--pt));
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .rh__card {
    display: flex;
    flex-direction: column;
    border-radius: calc(20 * var(--pt));
    background: var(--page);
  }
  .rh__row {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--pt));
    min-height: calc(52 * var(--pt));
    padding: calc(8 * var(--pt)) calc(18 * var(--pt));
  }
  .rh__row + .rh__row {
    box-shadow: inset 0 calc(1 * var(--pt)) 0 var(--rule);
  }
  .rh__icon {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(36 * var(--pt));
    height: calc(36 * var(--pt));
    margin-right: calc(4 * var(--pt));
    border-radius: calc(9 * var(--pt));
    color: #fff;
    font-weight: 700;
    font-size: calc(12 * var(--pt));
    letter-spacing: 0.02em;
  }
  .rh__icon > .pic {
    width: calc(20 * var(--pt));
    height: calc(20 * var(--pt));
  }
  .rh__badge {
    position: absolute;
    right: calc(-6 * var(--pt));
    bottom: calc(-6 * var(--pt));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(18 * var(--pt));
    height: calc(18 * var(--pt));
    border-radius: 999px;
    background: var(--page);
    box-shadow: 0 0 0 calc(1.5 * var(--pt)) var(--ink);
    color: var(--ink);
  }
  .rh__badge .pic {
    width: calc(12 * var(--pt));
    height: calc(12 * var(--pt));
  }
  /* A website: a plain 24pt globe in ink-2, with no tile and no padlock badge */
  .rh__glyph {
    flex: none;
    width: calc(24 * var(--pt));
    height: calc(24 * var(--pt));
    color: var(--ink-2);
  }
  .rh__text {
    display: flex;
    flex-direction: column;
    gap: calc(1 * var(--pt));
    min-width: 0;
  }
  .rh__text--add {
    gap: calc(2 * var(--pt));
  }
  .rh__name {
    font-size: calc(16 * var(--pt));
  }
  .rh__detail {
    font-size: calc(13 * var(--pt));
    line-height: 1.4;
    color: var(--ink-2);
  }
  .rh__limit {
    font-size: calc(16 * var(--pt));
    color: var(--ink-2);
  }
  .rh__link {
    color: var(--terracotta);
    font-weight: 600;
  }
  .rh__add {
    color: var(--terracotta);
    font-weight: 600;
    font-size: calc(16 * var(--pt));
  }
  .rh__footer {
    margin-top: calc(10 * var(--pt));
    padding: 0 calc(18 * var(--pt));
    font-size: calc(13 * var(--pt));
    line-height: 1.4;
    color: var(--ink-2);
  }

  @media (max-width: 1199.98px) {
    .features__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (max-width: 809.98px) {
    .features__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 40px;
    }
    .features__item .body {
      max-width: none;
    }
    .mock__panel {
      padding: 18px;
    }
    .mock__screen {
      border-radius: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mock__panel {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-features]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-feature]'));
    const stage = root.querySelector<HTMLElement>('[data-illustration]');
    if (!stage || tabs.length === 0) continue;

    const activate = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      stage.dataset.state = String(index + 1);
      stage.setAttribute('aria-labelledby', tabs[index].id);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') activate(i);
      });
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('focus', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const next = (i + (e.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].focus();
      });
    });
  }
</script>
