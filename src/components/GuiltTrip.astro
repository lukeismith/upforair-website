---
/**
 * The Guilt trip, as the app shows it (DESIGN.md §9 and GuiltTripPacing in the app repo):
 * the bunny at the edge of its hole says one line, typed at 30 characters a second with
 * a short beat after each sentence. Then the two replies fade in and type, in a random
 * order, so you have to read them. You choose one by holding it until its fill reaches
 * the far edge (three seconds); letting go drains it at the same rate. The lines are the
 * app's seventeen, and the ones tied to a time of day only show at that time of day.
 */
import Tag from './Tag.astro';
import sceneGuilt from '../assets/art/scene-guilt.svg?url';
import sceneRelieved from '../assets/art/scene-relieved.svg?url';
import sceneInHole from '../assets/art/scene-in-hole.svg?url';
import { guiltTrip } from '../data/site';

/** Without JavaScript (and before the card scrolls into view), the first line shows whole. */
const first = guiltTrip.lines[0];
const config = {
  lines: guiltTrip.lines,
  landing: guiltTrip.landing,
  carryOn: guiltTrip.carryOn,
  holdSeconds: guiltTrip.holdSeconds,
  charactersPerSecond: guiltTrip.charactersPerSecond,
};
---

<section class="section guilt" aria-labelledby="guilt-title">
  <div class="container guilt__inner">
    <div class="guilt__copy" data-appear>
      <Tag>{guiltTrip.tag}</Tag>
      <h2 id="guilt-title" class="h2" set:html={guiltTrip.title} />
      <p class="lead">{guiltTrip.body}</p>
      <button class="guilt__another" type="button" data-guilt-another>
        <svg class="pic"><use href="#p-carrot"></use></svg>
        {guiltTrip.reshuffle}
      </button>
    </div>

    <div class="card guilt__stage" data-appear data-guilt data-config={JSON.stringify(config)}>
      <div class="guilt__pause" data-guilt-pause>
        <div class="guilt__bubble">
          <span class="eyebrow">{guiltTrip.bubbleEyebrow}</span>
          <p class="guilt__line">
            <span class="sr-only" data-guilt-line-full aria-live="polite">{first.say}</span>
            <span class="guilt__sizer" data-guilt-line-sizer aria-hidden="true">{first.say}</span>
            <span class="guilt__typed" data-guilt-line aria-hidden="true">{first.say}</span>
          </p>
        </div>
        <img class="guilt__scene" src={sceneGuilt} alt="" width="200" height="130" loading="lazy" />
        <div class="guilt__replies" data-guilt-replies>
          {[first.stay, first.go].map((text, i) => (
            <button type="button" class="guilt__reply" data-reply={i === 0 ? 'stay' : 'go'}>
              <span class="guilt__fill" aria-hidden="true"></span>
              <span class="sr-only" data-reply-full>{text}</span>
              <span class="guilt__sizer" aria-hidden="true">{text}</span>
              <span class="guilt__typed" data-reply-text aria-hidden="true">{text}</span>
            </button>
          ))}
        </div>
        <p class="tiny muted guilt__hint">{guiltTrip.replyHint}</p>
      </div>

      <div class="guilt__landing" data-guilt-landing hidden>
        <img class="guilt__scene" data-landing-scene src={sceneRelieved} alt="" width="200" height="130" loading="lazy" />
        <span class="eyebrow" data-landing-eyebrow>{guiltTrip.landing.eyebrow}</span>
        <p class="guilt__landing-line serif-italic" data-landing-line></p>
        <p class="h4 guilt__landing-title" data-landing-title>{guiltTrip.landing.title}</p>
        <p class="small muted guilt__landing-body" data-landing-body></p>
        <button type="button" class="guilt__again" data-guilt-again>{guiltTrip.reshuffle}</button>
      </div>
      <span hidden data-scene-relieved={sceneRelieved} data-scene-hole={sceneInHole}></span>
    </div>
  </div>
</section>

<style>
  .guilt__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
  }
  .guilt__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .guilt__another {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    color: var(--link);
    font-weight: 600;
  }
  .guilt__another:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .guilt__stage {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    min-height: 460px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .guilt__pause,
  .guilt__landing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .guilt__bubble {
    position: relative;
    width: 100%;
    padding: 16px 18px 18px;
    border-radius: 16px;
    background: var(--solid);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .guilt__bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 16px;
    height: 16px;
    transform: translateX(-50%) rotate(45deg);
    background: var(--solid);
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .guilt__line {
    display: grid;
    margin-top: 6px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-variation-settings: 'SOFT' 60, 'WONK' 0;
    font-size: 23px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  /* The full text, invisible, holds the size; the typed text sits on top of it */
  .guilt__sizer,
  .guilt__typed {
    grid-area: 1 / 1;
  }
  .guilt__sizer {
    visibility: hidden;
  }
  .guilt__scene {
    width: 220px;
    height: auto;
  }
  .guilt__replies {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    transition: opacity 1s ease;
  }
  .guilt__replies.is-waiting {
    opacity: 0;
  }
  .guilt__reply {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 50px;
    padding: 12px 18px;
    overflow: hidden;
    border-radius: var(--radius-btn);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.25;
    text-align: center;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transform: scale(calc(1 + var(--fill, 0) * 0.05));
    transition: background-color 0.2s ease;
  }
  .guilt__reply .guilt__sizer,
  .guilt__reply .guilt__typed {
    position: relative;
  }
  .guilt__reply:hover {
    background: var(--well);
  }
  .guilt__fill {
    position: absolute;
    inset: 0;
    background: var(--apricot);
    opacity: 0.35;
    transform: scaleX(var(--fill, 0));
    transform-origin: left center;
    pointer-events: none;
  }
  .guilt__reply.is-chosen .guilt__fill {
    opacity: 0.5;
  }
  .guilt__hint {
    margin-top: -4px;
    text-align: center;
  }
  .guilt__landing-line {
    font-size: 26px;
    text-align: center;
  }
  .guilt__landing .eyebrow {
    margin-bottom: -10px;
  }
  .guilt__landing-title,
  .guilt__landing-body {
    text-align: center;
  }
  .guilt__landing-title {
    margin-bottom: -10px;
  }
  .guilt__landing-body {
    max-width: 380px;
  }
  .guilt__again {
    color: var(--link);
    font-weight: 600;
  }
  .guilt__again:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1199.98px) {
    .guilt__inner {
      gap: 40px;
    }
  }
  @media (max-width: 809.98px) {
    .guilt__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .guilt__stage {
      min-height: 0;
      padding: 22px 18px;
    }
    .guilt__line {
      font-size: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .guilt__reply {
      transform: none;
    }
    .guilt__replies {
      transition: none;
    }
  }
</style>

<script>
  type Line = { say: string; go: string; stay: string; hours?: [number, number] };
  type Config = {
    lines: Line[];
    landing: { eyebrow: string; lines: string[]; title: string; body: string };
    carryOn: { line: string; body: string };
    holdSeconds: number;
    charactersPerSecond: number;
  };
  type Kind = 'stay' | 'go';

  /** The extra wait after a sentence ends, and the replies' fade, as in GuiltTripPacing. */
  const SENTENCE_PAUSE = 0.25;
  const REPLIES_FADE = 1;

  /** When each character of a text appears, in seconds, with a beat after each sentence. */
  const schedule = (text: string, cps: number) => {
    const chars = Array.from(text);
    const ends = new Set(['.', '?', '!', '…']);
    const closers = new Set(['”', '’', '"', "'", ')']);
    const endsSentence = (end: number) => {
      let i = end - 1;
      while (i >= 0 && closers.has(chars[i])) i -= 1;
      return i >= 0 && ends.has(chars[i]);
    };
    const times: number[] = [];
    let pauses = 0;
    chars.forEach((c, i) => {
      if (/\s/.test(c) && endsSentence(i) && chars.slice(i + 1).some((n) => !/\s/.test(n))) pauses += 1;
      times.push(i / cps + pauses * SENTENCE_PAUSE);
    });
    return { chars, times, duration: chars.length / cps + pauses * SENTENCE_PAUSE, endsWithSentence: endsSentence(chars.length) };
  };
  const visible = (s: ReturnType<typeof schedule>, elapsed: number) =>
    s.chars.slice(0, s.times.filter((t) => t <= elapsed + 1e-9).length).join('');

  const shuffle = <T,>(items: T[]) => {
    const a = items.slice();
    for (let i = a.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };

  for (const stage of document.querySelectorAll<HTMLElement>('[data-guilt]')) {
    const config = JSON.parse(stage.dataset.config ?? '{}') as Config;
    const pause = stage.querySelector<HTMLElement>('[data-guilt-pause]')!;
    const landing = stage.querySelector<HTMLElement>('[data-guilt-landing]')!;
    const lineEl = stage.querySelector<HTMLElement>('[data-guilt-line]')!;
    const lineSizer = stage.querySelector<HTMLElement>('[data-guilt-line-sizer]')!;
    const lineFull = stage.querySelector<HTMLElement>('[data-guilt-line-full]')!;
    const replies = stage.querySelector<HTMLElement>('[data-guilt-replies]')!;
    const buttons = Array.from(replies.querySelectorAll<HTMLButtonElement>('[data-reply]'));
    const landingScene = stage.querySelector<HTMLImageElement>('[data-landing-scene]')!;
    const landingEyebrow = stage.querySelector<HTMLElement>('[data-landing-eyebrow]')!;
    const landingLine = stage.querySelector<HTMLElement>('[data-landing-line]')!;
    const landingTitle = stage.querySelector<HTMLElement>('[data-landing-title]')!;
    const landingBody = stage.querySelector<HTMLElement>('[data-landing-body]')!;
    const scenes = stage.querySelector<HTMLElement>('[data-scene-relieved]')!.dataset;
    const another = stage.closest('section')?.querySelector<HTMLButtonElement>('[data-guilt-another]');
    const again = stage.querySelector<HTMLButtonElement>('[data-guilt-again]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const holdMs = config.holdSeconds * 1000;

    // The lines for this hour, in a shuffled deck, as the app deals them.
    const hour = new Date().getHours();
    const fits = (line: Line) => {
      if (!line.hours) return true;
      const [from, to] = line.hours;
      return from < to ? hour >= from && hour < to : hour >= from || hour < to;
    };
    const eligible = config.lines.filter(fits);
    let deck: Line[] = [];
    let last: Line | undefined;
    const deal = () => {
      if (deck.length === 0) {
        deck = shuffle(eligible);
        if (deck.length > 1 && deck[0] === last) deck.push(deck.shift()!);
      }
      last = deck.shift()!;
      return last;
    };

    // --- The reveal ---
    let frame = 0;
    let acceptsHolds = true;
    let chosen = false;

    const reveal = (line: Line, order: Kind[]) => {
      window.cancelAnimationFrame(frame);
      const texts = order.map((kind) => line[kind]);
      buttons.forEach((btn, i) => {
        btn.dataset.reply = order[i];
        btn.querySelector<HTMLElement>('.guilt__sizer')!.textContent = texts[i];
        btn.querySelector<HTMLElement>('[data-reply-full]')!.textContent = texts[i];
      });
      lineSizer.textContent = line.say;
      lineFull.textContent = line.say;

      if (reduceMotion) {
        lineEl.textContent = line.say;
        buttons.forEach((btn, i) => (btn.querySelector<HTMLElement>('[data-reply-text]')!.textContent = texts[i]));
        replies.classList.remove('is-waiting');
        acceptsHolds = true;
        return;
      }

      const cps = config.charactersPerSecond;
      const say = schedule(line.say, cps);
      const answers = texts.map((t) => schedule(t, cps));
      const starts: number[] = [];
      let t = say.duration + REPLIES_FADE;
      answers.forEach((a, i) => {
        starts.push(t);
        t += a.duration;
        if (i < answers.length - 1 && a.endsWithSentence) t += SENTENCE_PAUSE;
      });
      const holdsFrom = starts[starts.length - 1];
      const total = t;

      lineEl.textContent = '';
      buttons.forEach((btn) => (btn.querySelector<HTMLElement>('[data-reply-text]')!.textContent = ''));
      replies.classList.add('is-waiting');
      acceptsHolds = false;

      const begin = performance.now();
      const tick = (now: number) => {
        const elapsed = (now - begin) / 1000;
        lineEl.textContent = visible(say, elapsed);
        if (elapsed >= say.duration) replies.classList.remove('is-waiting');
        answers.forEach((a, i) => {
          buttons[i].querySelector<HTMLElement>('[data-reply-text]')!.textContent = visible(a, elapsed - starts[i]);
        });
        acceptsHolds = elapsed >= holdsFrom;
        if (elapsed < total) frame = window.requestAnimationFrame(tick);
      };
      frame = window.requestAnimationFrame(tick);
    };

    // --- Holding a reply ---
    const fill = new Map<HTMLButtonElement, { value: number; pressed: boolean }>();
    buttons.forEach((btn) => fill.set(btn, { value: 0, pressed: false }));
    let holdFrame = 0;
    let lastTick = 0;

    const draw = (btn: HTMLButtonElement) => btn.style.setProperty('--fill', String(fill.get(btn)!.value));
    const resetFills = () => {
      buttons.forEach((btn) => {
        fill.set(btn, { value: 0, pressed: false });
        btn.classList.remove('is-chosen');
        draw(btn);
      });
    };

    const holdTick = (now: number) => {
      const dt = now - lastTick;
      lastTick = now;
      let moving = false;
      for (const btn of buttons) {
        const f = fill.get(btn)!;
        if (f.pressed) f.value = Math.min(1, f.value + dt / holdMs);
        else f.value = Math.max(0, f.value - dt / holdMs);
        draw(btn);
        if (f.pressed && f.value >= 1 && !chosen) {
          choose(btn.dataset.reply as Kind, btn);
          return;
        }
        if (f.pressed || f.value > 0) moving = true;
      }
      holdFrame = moving ? window.requestAnimationFrame(holdTick) : 0;
    };
    const run = () => {
      if (holdFrame) return;
      lastTick = performance.now();
      holdFrame = window.requestAnimationFrame(holdTick);
    };
    const press = (btn: HTMLButtonElement) => {
      if (!acceptsHolds || chosen) return;
      // One reply at a time, as in the app.
      if (buttons.some((b) => b !== btn && fill.get(b)!.pressed)) return;
      fill.get(btn)!.pressed = true;
      run();
    };
    const release = (btn: HTMLButtonElement) => {
      const f = fill.get(btn)!;
      if (!f.pressed) return;
      f.pressed = false;
      run();
    };

    let lastKey = 0;
    buttons.forEach((btn) => {
      btn.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        // Touch captures the pointer; let it go so sliding off the reply drains the fill.
        if (btn.hasPointerCapture(e.pointerId)) btn.releasePointerCapture(e.pointerId);
        press(btn);
      });
      btn.addEventListener('pointerup', () => release(btn));
      btn.addEventListener('pointerleave', () => release(btn));
      btn.addEventListener('pointercancel', () => release(btn));
      btn.addEventListener('contextmenu', (e) => e.preventDefault());
      btn.addEventListener('keydown', (e) => {
        if (e.key !== ' ' && e.key !== 'Enter') return;
        e.preventDefault();
        lastKey = performance.now();
        if (!e.repeat) press(btn);
      });
      btn.addEventListener('keyup', (e) => {
        if (e.key !== ' ' && e.key !== 'Enter') return;
        e.preventDefault();
        lastKey = performance.now();
        release(btn);
      });
      btn.addEventListener('blur', () => release(btn));
      // A screen reader activates a button without a press to hold: choose at once.
      btn.addEventListener('click', (e) => {
        if (e.detail !== 0 || performance.now() - lastKey < 600 || chosen) return;
        choose(btn.dataset.reply as Kind, btn);
      });
    });

    // --- The landing ---
    const choose = (kind: Kind, btn: HTMLButtonElement) => {
      chosen = true;
      fill.get(btn)!.value = 1;
      fill.get(btn)!.pressed = false;
      btn.classList.add('is-chosen');
      draw(btn);
      window.cancelAnimationFrame(holdFrame);
      holdFrame = 0;
      window.setTimeout(() => {
        const stayed = kind === 'stay';
        landingScene.src = stayed ? scenes.sceneRelieved! : scenes.sceneHole!;
        landingEyebrow.hidden = !stayed;
        landingTitle.hidden = !stayed;
        landingLine.textContent = stayed
          ? config.landing.lines[Math.floor(Math.random() * config.landing.lines.length)]
          : config.carryOn.line;
        landingBody.textContent = stayed ? config.landing.body : config.carryOn.body;
        pause.hidden = true;
        landing.hidden = false;
      }, 300);
    };

    const show = (line: Line) => {
      chosen = false;
      resetFills();
      landing.hidden = true;
      pause.hidden = false;
      const order: Kind[] = Math.random() < 0.5 ? ['stay', 'go'] : ['go', 'stay'];
      reveal(line, order);
    };
    const next = () => show(deal());

    again.addEventListener('click', next);
    another?.addEventListener('click', next);

    // Deal the first line once the card scrolls into view.
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        next();
        observer.disconnect();
      },
      { threshold: 0.4 },
    ).observe(stage);
  }
</script>
