---
/**
 * The single-colour bunny mark (head above the rim) from the Almanac design,
 * drawn in the current text colour.
 */
interface Props {
  class?: string;
  size?: number;
  style?: string;
}
const { class: cls, size = 28, style } = Astro.props;
---
<svg
  class={cls}
  style={style}
  width={size}
  height={size * 0.8}
  viewBox="0 0 100 80"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M16 70 a34 12 0 1 1 68 0 a34 12 0 1 1 -68 0 Z M24 62 a26 26 0 0 1 52 0 V70 H24 Z M30 40 Q28 8 38 4 Q44 10 42 38 Z M58 38 Q56 10 62 4 Q72 8 70 40 Z M35.5 48 a4.5 4.5 0 1 0 9 0 a4.5 4.5 0 1 0 -9 0 Z M55.5 48 a4.5 4.5 0 1 0 9 0 a4.5 4.5 0 1 0 -9 0 Z M42 54 Q50 64 58 54 Q50 59 42 54 Z"
    fill-rule="nonzero"
  ></path>
</svg>
