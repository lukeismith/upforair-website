---
/**
 * The single-colour bunny mark (the head above the rim, ears up), drawn in the current
 * text colour. It is the app's current mark (assets/marks/mark-head-out.svg in the app
 * repo's design reference) simplified to four ellipses, the same geometry as the
 * favicon in the marketing kit, so it carries none of the stock art and stays small.
 */
interface Props {
  class?: string;
  size?: number;
  style?: string;
}
const { class: cls, size = 28, style } = Astro.props;
---
<svg
  class={cls}
  style={style}
  width={size}
  height={size * 0.8}
  viewBox="0 0 100 80"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <ellipse cx="38.9" cy="20.4" rx="7.2" ry="18.9" transform="rotate(-11 38.9 20.4)"></ellipse>
  <ellipse cx="61.1" cy="20.4" rx="7.2" ry="18.9" transform="rotate(11 61.1 20.4)"></ellipse>
  <ellipse cx="50" cy="48.6" rx="20.7" ry="19.2"></ellipse>
  <ellipse cx="50" cy="67.8" rx="34.8" ry="11.7"></ellipse>
</svg>
