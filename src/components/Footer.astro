---
import { Image } from 'astro:assets';
import Logo from './icons/Logo.astro';
import Glow from './Glow.astro';
import glowBlue from '../assets/backgrounds/glow-blue.jpg';
import { brand, footer } from '../data/site';

const { newsletter, columns } = footer;
const credit = brand.credit;
---

<footer class="footer">
  <Glow src={glowBlue} hue={33} opacity={0.75} position="70% 100%" class="footer__glow" />

  <div class="footer__main container--wide">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label={`${brand.name} home`}>
        <Logo size={28} />
      </a>

      <div class="footer__newsletter">
        <h2 class="h4">{newsletter.title}</h2>
        <p class="body">{newsletter.body}</p>
        <form class="footer__form" method="POST" action={newsletter.action || undefined} data-newsletter>
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            class="footer__input"
            type="email"
            name="email"
            placeholder={newsletter.placeholder}
            autocomplete="email"
            required
          />
          <button class="footer__submit" type="submit">{newsletter.button}</button>
        </form>
      </div>
    </div>

    <div class="footer__columns">
      {columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul class="footer__links">
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  {credit && credit.name && (
    <div class="footer__bottom">
      <div class="footer__credit container--wide">
        <span class="dim">{credit.label}</span>
        <a class="footer__author" href={credit.url} target="_blank" rel="noopener">
          <Image src={credit.avatar} alt="" width={48} height={48} class="footer__avatar" />
          <span>{credit.name}</span>
        </a>
      </div>
    </div>
  )}
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .footer :global(.footer__glow) {
    -webkit-mask-image: radial-gradient(60% 80% at 75% 100%, #000 0%, transparent 100%);
    mask-image: radial-gradient(60% 80% at 75% 100%, #000 0%, transparent 100%);
  }
  .footer__main {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 64px;
    padding-block: 64px 56px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 420px;
  }
  .footer__logo {
    display: inline-flex;
    color: #fff;
  }
  .footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__form {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .footer__input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-btn);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border);
    color: #fff;
    font: inherit;
    font-size: 14px;
  }
  .footer__input::placeholder {
    color: var(--text-dim);
  }
  .footer__input:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .footer__submit {
    height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-btn);
    background: var(--primary);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 0 0 1px var(--primary-ring);
    transition: background-color 0.2s ease;
  }
  .footer__submit:hover {
    background: var(--primary-hover);
  }

  .footer__columns {
    display: flex;
    gap: 40px;
    padding-top: 4px;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 96px;
  }
  .footer__col-title {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer__links a {
    font-size: 13px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }
  .footer__links a:hover {
    color: #fff;
  }

  .footer__bottom {
    position: relative;
    z-index: 1;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .footer__credit {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block: 20px;
    font-size: 13px;
  }
  .footer__author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }
  .footer :global(.footer__avatar) {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 809.98px) {
    .footer__main {
      flex-direction: column-reverse;
      gap: 40px;
      padding-block: 56px 48px;
    }
    .footer__brand {
      max-width: none;
      gap: 32px;
    }
    .footer__columns {
      flex-direction: column;
      gap: 28px;
    }
    .footer__links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px 20px;
    }
    .footer__links a {
      font-size: 15px;
    }
    .footer__credit {
      justify-content: center;
    }
  }
</style>
