---
import Wordmark from './Wordmark.astro';
import Glow from './Glow.astro';
import { brand, footer } from '../data/site';

const { newsletter, columns } = footer;
---

<footer class="footer">
  <Glow color="var(--apricot)" x="78%" y="100%" width="55%" height="90%" opacity={0.16} />
  <div class="footer__main container--wide">
    <div class="footer__brand">
      <a href="/" class="footer__home" aria-label={`${brand.name} home`}>
        <Wordmark size="md" />
      </a>
      <p class="footer__tagline serif-italic">{brand.tagline}</p>

      <div class="footer__newsletter" id={newsletter.id}>
        <h2 class="h4">{newsletter.title}</h2>
        <p class="body">{newsletter.body}</p>
        <form class="footer__form" method="POST" action={newsletter.action || undefined} data-newsletter>
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            class="footer__input"
            type="email"
            name="email"
            placeholder={newsletter.placeholder}
            autocomplete="email"
            required
          />
          <button class="footer__submit" type="submit">{newsletter.button}</button>
        </form>
      </div>
    </div>

    <div class="footer__columns">
      {columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul class="footer__links">
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner container--wide">
      <span class="tiny muted">{footer.copyright}</span>
      <span class="tiny dim">{footer.artNote}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    box-shadow: inset 0 1px 0 var(--rule);
  }
  .footer__main {
    display: flex;
    justify-content: space-between;
    gap: 64px;
    padding-block: 64px 56px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 440px;
  }
  .footer__home {
    display: inline-flex;
  }
  .footer__tagline {
    font-size: 20px;
    color: var(--text-muted);
  }
  .footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 32px;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .footer__form {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .footer__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 46px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-btn);
    background: var(--well);
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }
  .footer__input::placeholder {
    color: var(--text-dim);
  }
  .footer__input:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .footer__submit {
    height: 46px;
    padding: 0 18px;
    border-radius: var(--radius-btn);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }
  .footer__submit:hover {
    background: var(--btn-bg-hover);
  }

  .footer__columns {
    display: flex;
    gap: 48px;
    padding-top: 6px;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 110px;
  }
  .footer__col-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-variation-settings: 'SOFT' 60, 'WONK' 0;
    font-size: 17px;
  }
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__links a {
    font-size: 15px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }
  .footer__links a:hover {
    color: var(--link);
  }

  .footer__bottom {
    position: relative;
    z-index: 1;
    box-shadow: inset 0 1px 0 var(--rule);
  }
  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
  }

  @media (max-width: 809.98px) {
    .footer__main {
      flex-direction: column;
      gap: 40px;
      padding-block: 48px 40px;
    }
    .footer__brand {
      max-width: none;
    }
    .footer__columns {
      gap: 32px;
    }
    .footer__form {
      flex-direction: column;
    }
    .footer__input {
      flex: none;
      width: 100%;
    }
    .footer__bottom-inner {
      flex-direction: column;
      gap: 4px;
      text-align: center;
    }
  }
</style>
