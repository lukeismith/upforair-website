---
import Star from './icons/Star.astro';
import LogoTicker from './LogoTicker.astro';
import { largeTestimonial } from '../data/site';
---

<section class="section quote" aria-label="Featured testimonial">
  <div class="container quote__inner">
    <figure class="quote__figure" data-appear>
      <div class="quote__stars" aria-label="Five out of five stars">
        {Array.from({ length: 5 }).map(() => <Star class="quote__star" />)}
      </div>
      <blockquote class="h2 quote__text" set:html={largeTestimonial.quote} />
      <figcaption class="lead quote__author">— {largeTestimonial.author}</figcaption>
    </figure>

    <LogoTicker section={false} class="quote__logos" />
  </div>
</section>

<style>
  .quote__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
  }
  .quote__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    margin: 0;
    text-align: center;
  }
  .quote__stars {
    display: flex;
    gap: 6px;
  }
  .quote :global(.quote__star) {
    width: 24px;
    height: 24px;
  }
  .quote__text {
    max-width: 760px;
    margin: 0;
    text-wrap: balance;
  }
  .quote__author {
    margin-top: 4px;
  }
</style>
