---
import Apple from './icons/Apple.astro';

interface Props {
  href?: string;
  size?: 'sm' | 'md';
  variant?: 'primary' | 'ghost';
  /** Show the Apple glyph before the label. */
  apple?: boolean;
  block?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  size = 'md',
  variant = 'primary',
  apple = false,
  block = false,
  type = 'button',
  class: cls,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const external = href?.startsWith('http');
---

<Tag
  href={href}
  type={href ? undefined : type}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class:list={['btn', `btn--${size}`, `btn--${variant}`, { 'btn--block': block }, cls]}
  {...rest}
>
  {apple && <Apple class="btn__icon" />}
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--radius-btn);
    background: var(--primary);
    color: #fff;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow:
      0 4px 10px -2px rgba(0, 0, 0, 0.05),
      0 2px 2px -1px rgba(0, 0, 0, 0.1),
      0 0 0 1px var(--primary-ring);
    transition:
      background-color 0.2s ease,
      transform 0.2s var(--ease-out),
      box-shadow 0.2s ease;
  }
  .btn:hover {
    background: var(--primary-hover);
  }
  .btn:active {
    transform: scale(0.98);
  }
  .btn--sm {
    padding: 9px 13px;
    border-radius: var(--radius-btn-sm);
  }
  .btn--ghost {
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--border);
  }
  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .btn--block {
    width: 100%;
  }
  .btn :global(.btn__icon) {
    width: 14px;
    height: 14px;
    flex: none;
    margin-top: -1px;
  }
</style>
