---
import Apple from './icons/Apple.astro';

interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  /** ink: the primary button. apricot: the warm accent. outlined: a hairline. text: terracotta text only. */
  variant?: 'ink' | 'apricot' | 'outlined' | 'text';
  /** Show the Apple glyph before the label. */
  apple?: boolean;
  block?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  size = 'md',
  variant = 'ink',
  apple = false,
  block = false,
  type = 'button',
  class: cls,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const external = href?.startsWith('http');
---

<Tag
  href={href}
  type={href ? undefined : type}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class:list={['btn', `btn--${size}`, `btn--${variant}`, { 'btn--block': block }, cls]}
  {...rest}
>
  {apple && <Apple class="btn__icon" />}
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 20px;
    border-radius: var(--radius-btn);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
    letter-spacing: -0.005em;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s var(--ease-out),
      box-shadow 0.2s ease;
  }
  .btn:hover {
    background: var(--btn-bg-hover);
  }
  .btn:active {
    transform: scale(0.985);
  }
  .btn--sm {
    padding: 9px 14px;
    border-radius: var(--radius-btn-sm);
    font-size: 15px;
    line-height: 18px;
  }
  .btn--lg {
    padding: 16px 24px;
    font-size: 17px;
    min-height: 52px;
  }
  .btn--apricot {
    background: var(--apricot);
    color: #1f1a17;
  }
  .btn--apricot:hover {
    background: #f3b071;
  }
  .btn--outlined {
    background: transparent;
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .btn--outlined:hover {
    background: var(--well);
  }
  .btn--text {
    padding-inline: 4px;
    background: transparent;
    color: var(--link);
  }
  .btn--text:hover {
    background: transparent;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .btn--block {
    width: 100%;
  }
  .btn :global(.btn__icon) {
    width: 15px;
    height: 15px;
    flex: none;
    margin-top: -2px;
  }
</style>
