---
import Tag from './Tag.astro';

interface Props {
  tag?: string;
  /** May contain `<em>` for the italic serif accent. */
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2';
  align?: 'center' | 'left';
  class?: string;
}
const { tag, title, subtitle, as: Heading = 'h2', align = 'center', class: cls } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`, cls]} data-appear>
  {tag && <Tag>{tag}</Tag>}
  <Heading class="h2 section-header__title" set:html={title} />
  {subtitle && <p class="lead section-header__sub">{subtitle}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 760px;
  }
  .section-header--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .section-header--left {
    align-items: flex-start;
    text-align: left;
  }
  .section-header__sub {
    max-width: 600px;
  }
</style>
